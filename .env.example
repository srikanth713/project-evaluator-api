# Copy to .env and fill in. Never commit .env.

# ---- Required ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Recommended ----
# Comma-separated list of allowed frontend origins. "*" is rejected when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:3000
# development | production
ENVIRONMENT=development
# Optional GitHub token (no scopes needed for public repos). Raises GitHub rate limit from 60 to 5000/hour.
GITHUB_TOKEN=
# Optional shared secret. If set, clients must send it in the X-API-Key header.
API_ACCESS_KEY=

# ---- Optional tuning ----
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GITHUB_TIMEOUT_SECONDS=15
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILES_TO_ANALYZE=10
MAX_TOTAL_CHARS=40000
# Private repos are refused unless this is true AND the request has repo_access_consent=true.
ALLOW_PRIVATE_REPOS=false
DATABASE_PATH=data/evaluations.db
